        "a1b2c3d4e5f60005"
      ]
    ],
    "outputs": 2,
    "name": "Validate and store / 校验与缓存",
    "func": "const reading = msg.payload;\nconst keys = [\"temp\", \"humi\", \"light\"];\nif (!reading || !keys.every((key) => Number.isFinite(reading[key]))) {\n    msg.statusCode = 400;\n    msg.payload = { error: \"Expected finite numeric temp, humi and light\" };\n    return [msg, null];\n}\nconst sample = {\n    temp: reading.temp,\n    humi: reading.humi,\n    light: reading.light,\n    receivedAt: new Date().toISOString()\n};\nflow.set(\"latestReading\", sample);\nmsg.statusCode = 200;\nmsg.payload = { ok: true };\nreturn [msg, { payload: sample }];\n",
    "initialize": "",
    "finalize": "",
    "libs": []
  },
